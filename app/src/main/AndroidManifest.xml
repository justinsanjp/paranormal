<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- EVP Recorder: Mikrofonzugriff -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- GhostBox: USB-OTG-Zugriff auf RTL-SDR-Dongle / USB-Antenne -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Foreground Service, damit lange EVP-Sessions nicht vom System gekillt werden -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- GhostApp: Session muss mit ausgeschaltetem Bildschirm weiterlaufen.
         Die genutzten Sensoren sind keine Wake-up-Sensoren, daher Wake Lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParanormalToolkit">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ParanormalToolkit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- GhostBox: offer to open when a known RTL-SDR dongle is plugged in -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <service
            android:name=".features.recorder.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".features.ghostapp.GhostAppService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous motion and magnetic field sensor session for a paranormal investigation tool" />
        </service>
    </application>
</manifest>
